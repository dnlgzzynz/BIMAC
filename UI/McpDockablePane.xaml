<Page x:Class="BAC_MCP.UI.McpDockablePane"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="380"
      Title="BAC MCP Assistant">

    <Page.Resources>
        <Style x:Key="TabHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Page.Resources>

    <Grid Background="#F0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / Connection Controls -->
        <StackPanel Grid.Row="0" Margin="10">
            <TextBlock Text="MCP Server:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="ServerSelector" SelectedIndex="0" Margin="0,0,0,5"
                      SelectionChanged="ServerSelector_SelectionChanged">
                <ComboBoxItem Content="Github (@modelcontextprotocol/server-github)"/>
                <ComboBoxItem Content="Google Maps (@modelcontextprotocol/server-google-maps)"/>
                <ComboBoxItem Content="Filesystem (@modelcontextprotocol/server-filesystem)"/>
                <ComboBoxItem Content="Airtable (airtable-mcp-server)"/>
                <ComboBoxItem Content="n8n (n8n-mcp)"/>
                <ComboBoxItem Content="Brave Search (@modelcontextprotocol/server-brave-search)"/>
                <ComboBoxItem Content="Puppeteer (@modelcontextprotocol/server-puppeteer)"/>
                <ComboBoxItem Content="SQLite (@modelcontextprotocol/server-sqlite)"/>
                <ComboBoxItem Content="PostgreSQL (@modelcontextprotocol/server-postgres)"/>
                <ComboBoxItem Content="Memory (@modelcontextprotocol/server-memory)"/>
                <ComboBoxItem Content="Sequential Thinking (@modelcontextprotocol/server-sequential-thinking)"/>
                <ComboBoxItem Content="Custom Server..."/>
            </ComboBox>

            <!-- Custom Server Configuration -->
            <StackPanel x:Name="CustomServerPanel" Visibility="Collapsed" Margin="0,0,0,5">
                <Border BorderBrush="#2196F3" BorderThickness="1" Background="#E3F2FD"
                        CornerRadius="3" Padding="8" Margin="0,5,0,0">
                    <StackPanel>
                        <TextBlock Text="Command:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CustomCommandType" SelectedIndex="0" Margin="0,0,0,5" FontSize="11">
                            <ComboBoxItem Content="npx (Node package)"/>
                            <ComboBoxItem Content="node (Script file)"/>
                            <ComboBoxItem Content="python"/>
                            <ComboBoxItem Content="Custom executable"/>
                        </ComboBox>

                        <TextBlock Text="Package/Script/Path:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox x:Name="CustomServerCommand" FontFamily="Consolas" FontSize="11"
                                 Padding="5" Margin="0,0,0,5"
                                 ToolTip="e.g., @anthropic/mcp-server-memory or path/to/script.js"/>

                        <TextBlock Text="Arguments (optional):" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox x:Name="CustomServerArgs" FontFamily="Consolas" FontSize="11"
                                 Padding="5"
                                 ToolTip="Additional arguments for the server"/>

                        <TextBlock Text="Environment Variables (optional):" FontWeight="SemiBold" FontSize="11" Margin="0,8,0,3"/>
                        <TextBox x:Name="CustomServerEnv" FontFamily="Consolas" FontSize="11"
                                 Padding="5" Height="40" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="KEY=value (one per line)&#x0a;e.g., GITHUB_TOKEN=xxx"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Connection Button and Status -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ConnectBtn" Content="Connect" Click="ConnectBtn_Click" Padding="10,5"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Ellipse x:Name="StatusIndicator" Width="10" Height="10" Fill="Red" Margin="0,0,5,0"/>
                    <TextBlock x:Name="StatusText" Text="Disconnected" FontSize="11"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Main Content with Tabs -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="10,0,10,10">

            <!-- Tools Tab -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Tools" Style="{StaticResource TabHeaderStyle}"/>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tools List Header -->
                    <Grid Grid.Row="0" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Available Tools:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button x:Name="RefreshToolsBtn" Grid.Column="1" Content="Refresh"
                                Click="RefreshToolsBtn_Click" Padding="8,3" FontSize="11"/>
                    </Grid>

                    <!-- Tools List -->
                    <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" Background="White"
                            MaxHeight="150" Margin="5,0,5,5">
                        <ListBox x:Name="ToolsList" SelectionChanged="ToolsList_SelectionChanged"
                                 BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="12"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Tool Description -->
                    <TextBlock x:Name="ToolDescription" Grid.Row="2" Text="" TextWrapping="Wrap"
                               FontStyle="Italic" Foreground="#666666" Margin="5,0,5,5" FontSize="11"
                               MaxHeight="40"/>

                    <!-- Arguments Input -->
                    <StackPanel Grid.Row="3" Margin="5,0,5,5">
                        <TextBlock Text="Arguments (JSON):" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" Background="White">
                            <TextBox x:Name="ArgumentsBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     Height="80" FontFamily="Consolas" FontSize="11" Padding="5"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Border>
                        <Button x:Name="ExecuteToolBtn" Content="Execute Tool" Click="ExecuteToolBtn_Click"
                                Padding="10,8" Margin="0,8,0,0" FontWeight="Bold"
                                Background="#4CAF50" Foreground="White"/>
                    </StackPanel>

                    <!-- Output Area -->
                    <Border Grid.Row="4" Margin="5" BorderBrush="#CCCCCC" BorderThickness="1" Background="White">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Background="#EEEEEE">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Output:" FontWeight="Bold" Padding="5" VerticalAlignment="Center"/>
                                <Button x:Name="ClearOutputBtn" Grid.Column="1" Content="Clear"
                                        Click="ClearOutputBtn_Click" Padding="8,3" Margin="5" FontSize="11"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" x:Name="OutputScroller">
                                <TextBlock x:Name="OutputText" TextWrapping="Wrap" Padding="5"
                                           FontFamily="Consolas" FontSize="11"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Resources Tab -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Resources" Style="{StaticResource TabHeaderStyle}"/>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Resources List Header -->
                    <Grid Grid.Row="0" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Available Resources:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button x:Name="RefreshResourcesBtn" Grid.Column="1" Content="Refresh"
                                Click="RefreshResourcesBtn_Click" Padding="8,3" FontSize="11"/>
                    </Grid>

                    <!-- Resources List -->
                    <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" Background="White"
                            MaxHeight="150" Margin="5,0,5,5">
                        <ListBox x:Name="ResourcesList" SelectionChanged="ResourcesList_SelectionChanged"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="12"/>
                                        <TextBlock Text="{Binding Uri}" FontSize="10" Foreground="Gray"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Resource Description -->
                    <StackPanel Grid.Row="2" Margin="5,0,5,5">
                        <TextBlock x:Name="ResourceDescription" Text="" TextWrapping="Wrap"
                                   FontStyle="Italic" Foreground="#666666" FontSize="11"/>
                        <Button x:Name="ReadResourceBtn" Content="Read Resource" Click="ReadResourceBtn_Click"
                                Padding="10,8" Margin="0,8,0,0" Background="#2196F3" Foreground="White"/>
                    </StackPanel>

                    <!-- Resource Content -->
                    <Border Grid.Row="3" Margin="5" BorderBrush="#CCCCCC" BorderThickness="1" Background="White">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Content:" FontWeight="Bold" Padding="5" Background="#EEEEEE"/>
                            <ScrollViewer Grid.Row="1">
                                <TextBlock x:Name="ResourceContent" TextWrapping="Wrap" Padding="5"
                                           FontFamily="Consolas" FontSize="11"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Prompts Tab -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Prompts" Style="{StaticResource TabHeaderStyle}"/>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Prompts List Header -->
                    <Grid Grid.Row="0" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Available Prompts:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button x:Name="RefreshPromptsBtn" Grid.Column="1" Content="Refresh"
                                Click="RefreshPromptsBtn_Click" Padding="8,3" FontSize="11"/>
                    </Grid>

                    <!-- Prompts List -->
                    <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" Background="White"
                            MaxHeight="120" Margin="5,0,5,5">
                        <ListBox x:Name="PromptsList" SelectionChanged="PromptsList_SelectionChanged"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="12"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Prompt Description -->
                    <TextBlock x:Name="PromptDescription" Grid.Row="2" Text="" TextWrapping="Wrap"
                               FontStyle="Italic" Foreground="#666666" Margin="5,0,5,5" FontSize="11"/>

                    <!-- Prompt Arguments -->
                    <StackPanel Grid.Row="3" Margin="5,0,5,5">
                        <TextBlock Text="Arguments (JSON):" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" Background="White">
                            <TextBox x:Name="PromptArgumentsBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     Height="60" FontFamily="Consolas" FontSize="11" Padding="5"/>
                        </Border>
                        <Button x:Name="GetPromptBtn" Content="Get Prompt" Click="GetPromptBtn_Click"
                                Padding="10,8" Margin="0,8,0,0" Background="#9C27B0" Foreground="White"/>
                    </StackPanel>

                    <!-- Prompt Messages -->
                    <Border Grid.Row="4" Margin="5" BorderBrush="#CCCCCC" BorderThickness="1" Background="White">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Messages:" FontWeight="Bold" Padding="5" Background="#EEEEEE"/>
                            <ScrollViewer Grid.Row="1">
                                <TextBlock x:Name="PromptMessages" TextWrapping="Wrap" Padding="5"
                                           FontFamily="Consolas" FontSize="11"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Quick Command Input -->
        <Grid Grid.Row="2" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Grid.Column="0" Padding="5"
                     KeyDown="InputBox_KeyDown"
                     ToolTip="Enter command. Use Up/Down arrows for history. Press Enter to send."/>
            <Button x:Name="SendBtn" Grid.Column="1" Content="Send"
                    Click="SendBtn_Click" Padding="10,5" Margin="5,0,0,0"/>
        </Grid>

        <!-- Progress Overlay -->
        <Border x:Name="ProgressOverlay" Grid.RowSpan="3" Visibility="Collapsed"
                Background="#80000000" Panel.ZIndex="100">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar x:Name="OperationProgress" IsIndeterminate="True"
                             Width="200" Height="20"/>
                <TextBlock x:Name="ProgressText" Text="Processing..."
                           Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0"
                           FontSize="14"/>
                <Button x:Name="CancelOperationBtn" Content="Cancel"
                        Click="CancelOperationBtn_Click" Margin="0,15,0,0" Padding="15,8"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
